{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "regions": ["gru1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{.env*,node_modules/**,tests/**,database/**,storage/**,.claude/**,.ai/**}"
    }
  },
  "routes": [
    {"src": "/assets/(.*)", "dest": "/public/assets/$1", "headers": {"Cache-Control": "public, max-age=31536000, immutable"}},
    {"src": "/favicon.svg", "dest": "/public/favicon.svg"},
    {"src": "/robots.txt", "dest": "/public/robots.txt"},
    {"src": "/(.*)", "dest": "/api/index.php"}
  ]
}
